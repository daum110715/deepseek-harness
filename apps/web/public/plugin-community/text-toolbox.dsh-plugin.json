{
  "format": "dsh-web-plugin",
  "id": "text-toolbox-example",
  "name": "Text toolbox example",
  "version": "1.0.0",
  "description": "A sample standalone browser plugin that counts characters without sending text anywhere",
  "author": "DSH Web example",
  "runtime": "dsh-web",
  "apiVersion": 1,
  "dependencies": {},
  "permissions": [],
  "html": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Text toolbox example</title><style>body{font:16px system-ui;margin:24px;color:#202124}h1{font-size:22px;font-weight:500}textarea{box-sizing:border-box;width:100%;min-height:220px;font:inherit;padding:12px;border:1px solid #aab0b8;border-radius:8px}output{display:block;margin-top:16px}</style><h1>Text toolbox example</h1><textarea aria-label=\"Text to count\" placeholder=\"Write or paste text here\"></textarea><output aria-live=\"polite\">0 characters</output><script>const input=document.querySelector('textarea');input.addEventListener('input',()=>{document.querySelector('output').textContent=input.value.length+' characters'});</script></html>"
}
